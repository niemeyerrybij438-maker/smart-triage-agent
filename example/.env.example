# Runtime mode: development or production.
# Production enables strict credential, map and SMS configuration validation.
APP_ENV=development

# OpenAI-compatible model endpoint. Required in every environment.
BaseUrl=https://api.openai.com/v1
APIKey=replace-with-your-api-key
Model=gpt-5-nano

# MySQL database. Required in every environment; no default password is built in.
# Create the database before starting the service.
MYSQL_DSN=root:replace-with-password@tcp(127.0.0.1:3306)/aggo?charset=utf8mb4&parseTime=True&loc=Local
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_MINUTES=5

# Docker Compose MySQL container credentials (local development defaults only).
# Use unique strong values for any shared or production environment.
MYSQL_USER=aggo
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# HTTP server
PORT=8080
# Host port used by Docker Compose. Keep 8081 while the native service uses 8080.
DOCKER_PORT=8081

# Doctor workbench login.
# Development may use local demo credentials. Production must use a custom password
# with at least 12 characters and must not use the placeholder below.
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD=replace-with-a-strong-password
DOCTOR_DISPLAY_NAME=Doctor

# Admin console login. The same production password requirements apply.
ADMIN_USERNAME=medical_admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_DISPLAY_NAME=Platform Administrator

# Patient services
# Development never calls the SMS provider and returns a local debugCode.
# Production must configure either IHUYI_ACCOUNT + IHUYI_PASSWORD or SMS_PROVIDER_URL.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
IHUYI_ACCOUNT=
IHUYI_PASSWORD=
IHUYI_TEMPLATE_ID=1

# Chinese TTF font used by generated PDF reports
PDF_FONT_PATH=C:\Windows\Fonts\Deng.ttf

# Baidu Maps JavaScript API GL
BAIDU_MAP_AK=replace-with-your-baidu-map-ak
