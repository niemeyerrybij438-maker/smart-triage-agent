# OpenAI-compatible model endpoint
BaseUrl=https://api.openai.com/v1
APIKey=replace-with-your-api-key
Model=gpt-5-nano

# MySQL database. The database must already exist.
MYSQL_DSN=root:123456@tcp(127.0.0.1:3306)/aggo

# HTTP server
PORT=8080

# Doctor workbench login
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD=replace-with-a-strong-password
DOCTOR_DISPLAY_NAME=李医生
